{
    "version": "2.0.1",
    "tasks": [
        {
            "label": "Docker: Build firmware (NERDQAXEPLUS2)",
            "type": "shell",
            "command": "./docker/idf-run.sh \"idf.py build\"",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "BOARD": "NERDQAXEPLUS2"
                }
            },
            "windows": {
                "command": "docker run --rm -v \"${workspaceFolder}:/home/builder/project\" -e BOARD=NERDQAXEPLUS2 esp-idf-builder /bin/bash -lc \"idf.py build\""
            },
            "problemMatcher": [
                {
                    "owner": "cpp",
                    "fileLocation": ["relative", "${workspaceFolder}"],
                    "pattern": {
                        "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                        "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
                    }
                }
            ],
            "group": "build"
        },
        {
            "label": "Docker: Set target esp32s3",
            "type": "shell",
            "command": "./docker/idf-run.sh \"idf.py set-target esp32s3\"",
            "options": { "cwd": "${workspaceFolder}" },
            "windows": {
                "command": "docker run --rm -v \"${workspaceFolder}:/home/builder/project\" -e BOARD=NERDQAXEPLUS2 esp-idf-builder /bin/bash -lc \"idf.py set-target esp32s3\""
            },
            "problemMatcher": []
        },
        {
            "label": "Docker: Full clean",
            "type": "shell",
            "command": "./docker/idf-run.sh \"idf.py fullclean\"",
            "options": { "cwd": "${workspaceFolder}" },
            "windows": {
                "command": "docker run --rm -v \"${workspaceFolder}:/home/builder/project\" -e BOARD=NERDQAXEPLUS2 esp-idf-builder /bin/bash -lc \"idf.py fullclean\""
            },
            "problemMatcher": []
        },
        {
            "label": "Docker: menuconfig",
            "type": "shell",
            "command": "./docker/idf-shell.sh",
            "options": { "cwd": "${workspaceFolder}" },
            "windows": {
                "command": "docker run --rm -it -v \"${workspaceFolder}:/home/builder/project\" -e BOARD=NERDQAXEPLUS2 esp-idf-builder /bin/bash -lc \"idf.py menuconfig\""
            },
            "presentation": { "reveal": "always", "panel": "new" },
            "problemMatcher": []
        },
        {
            "label": "Docker: Build image (esp-idf-builder)",
            "type": "shell",
            "command": "./docker/build_docker.sh",
            "options": { "cwd": "${workspaceFolder}" },
            "windows": {
                "command": "docker build -t esp-idf-builder \"${workspaceFolder}/docker\""
            },
            "problemMatcher": []
        },
        {
            "label": "Web UI: npm install & build",
            "type": "shell",
            "command": "./docker/idf-run.sh \"cd /home/builder/project/main/http_server/axe-os && npm ci && npm run build\"",
            "options": { "cwd": "${workspaceFolder}" },
            "windows": {
                "command": "docker run --rm -v \"${workspaceFolder}:/home/builder/project\" -w /home/builder/project/main/http_server/axe-os esp-idf-builder /bin/bash -lc \"npm ci && npm run build\""
            },
            "problemMatcher": []
        },
        {
            "label": "Build - Build project with Docker",
            "type": "shell",
            "command": "docker run --rm -v \"${workspaceFolder}\":/home/builder/project -e BOARD=NERDQAXEPLUS2 esp-idf-builder /bin/bash -lc 'idf.py build'",
            "options": {
                "env": {
                    "PATH": "${env:PATH}"
                }
            },
            "problemMatcher": [
                {
                    "owner": "cpp",
                    "fileLocation": [
                        "relative",
                        "${workspaceFolder}"
                    ],
                    "pattern": {
                        "regexp": "^\\.\\.(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "severity": 4,
                        "message": 5
                    }
                },
                {
                    "owner": "cpp",
                    "fileLocation": "absolute",
                    "pattern": {
                        "regexp": "^[^\\.](.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "severity": 4,
                        "message": 5
                    }
                }
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "windows": {
                "command": "docker run --rm -v \"${workspaceFolder}:/home/builder/project\" -e BOARD=NERDQAXEPLUS2 esp-idf-builder /bin/bash -lc \"idf.py build\"",
                "options": {
                    "env": {
                        "PATH": "${env:PATH}"
                    }
                }
            }
        },
        {
            "label": "Build - Build project",
            "type": "shell",
            "command": "${config:idf.pythonBinPath} ${config:idf.espIdfPath}/tools/idf.py build",
            "windows": {
                "command": "${config:idf.pythonBinPathWin} ${config:idf.espIdfPathWin}\\tools\\idf.py build",
                "options": {
                    "env": {
                        "PATH": "${env:PATH};${config:idf.customExtraPaths}"
                    }
                }
            },
            "options": {
                "env": {
                    "PATH": "${env:PATH}:${config:idf.customExtraPaths}"
                }
            },
            "problemMatcher": [
                {
                    "owner": "cpp",
